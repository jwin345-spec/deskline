# Copy to .env for local development: `cp .env.example .env`

# Embedded Postgres (PGlite, WASM) persisted to ./.data - no Docker required.
DATABASE_URL=pglite:./.data/deskline
# A real server, e.g. the one from docker-compose.yml:
# DATABASE_URL=postgres://deskline:deskline@localhost:5432/deskline

# Optional. Enables the "Suggest reply" button. Without it the button is
# disabled with an explanation and everything else works.
# ANTHROPIC_API_KEY=

# Background SLA worker (runs in-process with the web server).
SLA_WORKER_ENABLED=true
SLA_WORKER_POLL_MS=2000

# Set to true behind HTTPS so the session cookie gets the Secure attribute.
COOKIE_SECURE=false
